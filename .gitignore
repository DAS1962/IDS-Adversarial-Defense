# Environnement Python
venv/
ENV/
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
.python-version

# Données brutes et prétraitées (trop lourdes)
data
data/
data/raw/
data/processed/
*.csv
*.pcap
*.parquet

# Pickles de données (X_train, X_test, etc.) mais pas les résultats
data/**/*.pkl
results/attacks/*.pkl

# Modèles : ignorer partout SAUF results/checkpoints/
*.pth
*.pt
*.h5
*.ckpt
!results/checkpoints/*.pth
!results/checkpoints/*.pt
!results/checkpoints/*.h5
!results/checkpoints/*.ckpt

# Logs SLURM et logs texte
results/logs/slurm_*.out
results/logs/slurm_*.err
results/logs/*.txt

# Figures : autoriser final_*, attacks_*, cm_*
results/figures/*.png
!results/figures/final_*.png
!results/figures/attacks_*.png
!results/figures/cm_*.png
!results/figures/defenses_*.png
!results/figures/ensemble_*.png
# branche reproduction-fidele
!results/figures/baselines_*.png
!results/figures/accuracy_*.png
!results/figures/ecarts_*.png
!results/figures/f1_*.png
!results/figures/heatmap_*.png
!results/figures/rappel_*.png
!results/figures/perturbations.png
!results/figures/*.csv

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets
.env
*.key
kaggle.json

# Historiques d'entraînement (trop lourds, contiennent toutes les prédictions)
results/logs/*.pkl

# Artefacts de la branche main : ils vivent sur main, pas ici. Le worktree
# partage l'arborescence de travail, donc ils sont presents sur disque.
scripts/0[2-9]*_*
scripts/1[0-7]_*
!scripts/02_baseline*
!scripts/03_attaques*
!scripts/04_evaluation*
!scripts/05_tableau_comparaison*
!scripts/06_figures*
src/defenses/common.py
src/models/substitute.py
results/figures/attacks_*
results/figures/cm_*
results/figures/defenses_*
results/figures/ensemble_*
results/figures/final_*
results/checkpoints/baseline_best.pth
results/checkpoints/baseline_v*.pth
