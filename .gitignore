# Pickles de données (X_train, X_test, etc.) mais pas les résultats
data/**/*.pkl
results/attacks/*.pkl

# Modèles : ignorer partout SAUF results/checkpoints/
*.pth
*.pt
*.h5
*.ckpt
!results/checkpoints/*.pth
!results/checkpoints/*.pt
!results/checkpoints/*.h5
!results/checkpoints/*.ckpt

# Logs SLURM et logs texte
results/logs/slurm_*.out
results/logs/slurm_*.err
